const Post = require("../models/Post");

const getPosts = async (req, res) => {
  try {
      const posts = await Post.find().sort({ createdAt: -1 });

          res.status(200).json(posts);
            } catch (error) {
                res.status(500).json({
                      message: "Failed to fetch posts",
                            error: error.message,
                                });
                                  }
                                  };

                                  module.exports = {
                                    getPosts,
                                    };
